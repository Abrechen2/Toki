    "Erstes Ankommen = Beginn, letztes Verlassen = Ende, auf 5 Minuten gerundet. Aufenthalte unter 1 Stunde zählen nicht. Tage, die du von Hand einträgst, bleiben unangetastet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First arrival = start, last departure = end, rounded to 5 minutes. Stays under 1 hour do not count. Days you enter by hand are never touched."
          }
        }
      }
    },
