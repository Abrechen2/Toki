    "Das Soll wird pro Tag gespeichert; spätere Änderungen am Wochenplan ändern vergangene Tage nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The target is stored per day; later schedule changes never alter past days."
          }
        }
      }
    },
